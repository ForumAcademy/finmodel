{
  "name": "finmodel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "validate:spec": "python3 scripts/validate_spec.py",
    "spec:build": "pnpm --filter @fm/spec spec:build",
    "spec:check": "pnpm --filter @fm/spec spec:check",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm --filter @fm/web build",
    "dev": "pnpm --filter @fm/web dev",
    "map:build": "pnpm --filter @fm/excel-import map:build",
    "map:check": "pnpm --filter @fm/excel-import map:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
